# =================================================================
# AI Privacy Layer: Environment Configuration (Local Deployment)
# =================================================================
# NOTE: The platform works 100% out of the box with zero configuration!
# You do NOT need to set any variables below unless you wish to
# customize ports or provide your own upstream API keys.
# =================================================================

# Server Port (Default: 8787)
PORT=8787

# Upstream LLM Provider API Keys (Optional overrides)
# If left blank, the platform automatically utilizes its built-in
# fallback keys for Groq, Gemini, OpenRouter, and Mistral.
# OPENAI_API_KEY=your_openai_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# MISTRAL_API_KEY=your_mistral_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Upstream Gateway URL Override (Optional)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# SIEM Audit Webhook URL (Optional for enterprise logging)
# AUDIT_WEBHOOK_URL=https://your-siem-collector.internal/audit
